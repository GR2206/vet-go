{
  "expo": {
    "name": "PETS&GO",
    "slug": "vetgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/petsgo-icon.png",
    "scheme": "vetgo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/petsgo-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F4F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grproducciones.vetgo",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PETS&GO usa tu ubicación para mostrar lugares cerca y la zona aproximada de tu mascota.",
        "LSApplicationQueriesSchemes": [
          "mercadopago",
          "personalpay",
          "mipersonalpay",
          "uala",
          "modo",
          "naranjax",
          "comgooglemaps",
          "maps"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/petsgo-adaptive.png",
        "backgroundColor": "#F5F4F1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.grproducciones.vetgo",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/petsgo-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F4F1",
          "image": "./assets/images/petsgo-splash.png",
          "imageWidth": 260
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PETS&GO usa tu ubicación para el clima, parques cerca y la zona de tu mascota."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PETS&GO usa tus fotos para la ficha de tu mascota.",
          "cameraPermission": "PETS&GO usa la cámara para la ficha de tu mascota.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/petsgo-icon.png",
          "color": "#C9A227",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "company": "GR Producciones",
      "projectNumber": 3,
      "projectName": "PETS&GO",
      "router": {},
      "eas": {
        "projectId": "23be858d-290e-4551-9f67-a6f418d16026"
      }
    },
    "owner": "g2206"
  }
}

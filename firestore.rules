rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Demo: lectura/escritura abierta para conectar app y panel.
    // Cuando haya login de dueños, restringir writes al comercio dueño.
    match /shops/{shopId}/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}

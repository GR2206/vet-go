# Copiá este archivo a `.env` en la raíz del repo y completá los valores.

# Firebase (Consola → Configuración → App web)
# Obligatorio para chat/pedidos cuando la app y el panel NO están en la misma red.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Seguridad catálogo en vivo (generá valores largos y distintos)
# Solo servidor (owner-web Vite): no uses prefijo EXPO_PUBLIC_
LIVE_SESSION_SECRET=
LIVE_APP_WRITE_KEY=

# App móvil: misma clave que LIVE_APP_WRITE_KEY (panel local en la misma Wi‑Fi)
EXPO_PUBLIC_LIVE_APP_WRITE_KEY=

# Clave del dueño en Firebase Auth (solo panel, NUNCA EXPO_PUBLIC_)
# Si está vacío, se usa LIVE_SESSION_SECRET.
VITE_OWNER_AUTH_SECRET=

# Panel de dueños publicado (Firebase Hosting)
EXPO_PUBLIC_OWNER_PANEL_URL=https://petsgo-e8c6d.web.app

